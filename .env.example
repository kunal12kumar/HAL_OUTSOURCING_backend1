# Copy to .env next to docker-compose.yml and fill in. Never commit the real .env.

# ---- Docker Compose (required) ----
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-characters

# ---- Docker Compose (optional) ----
# Where the API listens on the host. Default is this machine only.
# For a separate frontend server use API_BIND=0.0.0.0 and firewall the port to the frontend host.
API_BIND=127.0.0.1
API_PORT=8765
# Host names the API will answer to: the name or IP the FRONTEND uses in BACKEND_URL. Comma separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Keep 0 when the API sits behind a TLS-terminating proxy or is reached over a private network.
DJANGO_SSL_REDIRECT=0
VENDOR_STALE_DAYS=7
# Project name. Set to hal_outsourcing to reuse the volumes of the old combined compose file.
COMPOSE_PROJECT_NAME=hal-backend

# ---- Running without Docker (development only) ----
# DJANGO_DEBUG=1
